# Spring Boot API base URL used by the legacy registration flow.
VITE_API_BASE_URL=http://localhost:8080

# --- Gallery (Supabase Storage) -------------------------------------------
# Project URL for the Supabase project that hosts the `docs` storage bucket.
# This value is public (it ships in every client bundle) so it is safe here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# PUBLIC anon (or publishable) key for the project. This is the only key the
# Gallery ever uses and it is inlined into the browser bundle at build time.
# NEVER put a service_role key, sb_secret_*, sbp_* personal access token or any
# other privileged credential here — it would become public.
VITE_SUPABASE_ANON_KEY=

# Storage bucket that holds the event folders (optional, `docs` by default).
VITE_SUPABASE_STORAGE_BUCKET=docs
